# Fake local placeholders only. Do not put real OCI credentials or secrets here.
APP_ENV=local
LOG_LEVEL=debug

OCI_TENANCY_OCID=ocid1.tenancy.oc1..example
OCI_USER_OCID=ocid1.user.oc1..example
OCI_REGION=us-ashburn-1
OCI_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
OCI_KEY_FILE=./local/fake_oci_api_key.pem
OCI_PROFILE=DEFAULT

DATABASE_URL=oracle+oracledb://fake_user:fake_password@localhost:1521/FREEPDB1
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=5173
OCI_SENTINEL_DB_PATH=./data/oci-sentinelmesh.db
OCI_SENTINEL_PERSISTENCE_ENABLED=true
